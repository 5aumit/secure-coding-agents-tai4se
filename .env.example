# Copy to .env and fill in your values. .env is ignored by git.
# Load it before running either benchmark: set -a; source .env; set +a

# Model provider: create a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Langfuse tracing (optional). Ask the project owner to invite you, then create
# keys in the Langfuse project under Settings > API Keys.
LANGFUSE_TRACING_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://us.cloud.langfuse.com

# Run labels shown in Langfuse
# RUN_BY: your name, so your traces are easy to find
RUN_BY=
# EXPERIMENT_NAME: short, lowercase, hyphenated name for the setting being tested
EXPERIMENT_NAME=baseline
